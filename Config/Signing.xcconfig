// Default signing: ad-hoc ("Sign to Run Locally").
// With ad-hoc signing, macOS revokes the Accessibility permission after each rebuild.
// To keep it, create Config/Signing.local.xcconfig (git-ignored) containing:
//   DEVELOPMENT_TEAM = <your Personal Team ID>
//   CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
